{
  "name": "hackathon-agent-infra",
  "version": "1.0.0",
  "description": "Infraestructura base modular en TypeScript con Docker y Cloudflare Tunnel",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "keywords": [
    "hackathon",
    "agent",
    "cloudflare-tunnel",
    "docker",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@qdrant/js-client-rest": "^1.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "neo4j-driver": "^6.2.0",
    "pg": "^8.23.0",
    "tweetnacl": "^1.0.3",
    "youtube-transcript": "^1.3.1",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
